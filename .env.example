# Copy this file to ".env" and fill in what you need. Everything is optional for local testing.

PORT=3000
# The public address of your shop (used in emails and Paystack return links). No trailing slash.
BASE_URL=http://localhost:3000

# Paystack secret key (starts with sk_test_ or sk_live_). Leave empty to run online payment in demo mode.
PAYSTACK_SECRET_KEY=

# Email through Resend (https://resend.com). Leave empty and emails are only stored in Admin > Marketing.
RESEND_API_KEY=
MAIL_FROM=Shop-Beta <orders@yourdomain.com>

# Optional: create the admin account at first start instead of through the /admin page.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# PostgreSQL connection string. Supabase: Project Settings > Database > Connection string > Transaction pooler (port 6543), with your password filled in.
# Local development: postgres://postgres@127.0.0.1:5432/shopbeta_dev  (create the empty database first: createdb shopbeta_dev)
DATABASE_URL=postgres://postgres@127.0.0.1:5432/shopbeta_dev
# SSL to the database: on (default for non-local hosts), off (default for localhost), or no-verify (only if your host's certificate cannot be verified)
DATABASE_SSL=
# Connections per app instance. With 2 instances on Supabase keep the total (2 x this number) under the pooler limit.
DB_POOL_MAX=10

# Product photos: Supabase Storage. In Supabase create a PUBLIC bucket named product-images (Storage > New bucket > tick "Public bucket").
# SUPABASE_URL is https://<project-ref>.supabase.co ; the service role key is under Project Settings > API. Keep that key secret: only on the server, never in the browser or GitHub.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=product-images
# Local development without Supabase: photos are saved under DATA_DIR/uploads. With NODE_ENV=production the server refuses to start in that mode.
DATA_DIR=

# 0 = start with an empty catalogue (no demo products)
SEED_DEMO=1

# Hours ahead of UTC for "today" on the dashboard (Nigeria = 1)
TZ_OFFSET_HOURS=1
# Set to 0 only if the server is exposed directly to the internet with no proxy in front
TRUST_PROXY=1

# Background worker (optional)
# WORKER_ENABLED=0        # set on web instances if you run "npm run worker" as its own service
# WORKER_CONCURRENCY=4

# Delivery maps (step 6A)
# GEOAPIFY_API_KEY=       # free plan is enough to start; restrict the key to your domain
# HANDOVER_SECRET=        # long random text; the delivery codes are derived from it

# --- Step 7: security ---
# Production: the first-run admin page is closed. Either set ADMIN_EMAIL + ADMIN_PASSWORD (12+ characters),
# or set a SETUP_CODE and open /admin once to create the owner with that code.
SETUP_CODE=
# Demo payments are always off in production. Only for a staging site that has no Paystack key:
ALLOW_DEMO_PAYMENTS=
# Behind Cloudflare the real visitor IP is read from CF-Connecting-IP, but only when the request came from a Cloudflare address.
# Override the built-in Cloudflare ranges (comma separated) only if Cloudflare changes them.
CLOUDFLARE_RANGES=

# --- Step 8: operations ---
# Backups run nightly in production. Create a PRIVATE Supabase Storage bucket called "backups" (or set SUPABASE_BACKUP_BUCKET).
BACKUP_PASSPHRASE=            # long random phrase; encrypts backup files. Keep a copy OUTSIDE Render: without it backups cannot be opened
BACKUP_KEEP=14                # how many backup files to keep (minimum 3)
BACKUP_ENABLED=               # 1 = on, 0 = off (default: on in production, off elsewhere)
BACKUP_MAX_AGE_HOURS=30       # the admin panel warns when the last good backup is older than this
LOG_LEVEL=info                # debug | info | warn | error
LOG_FORMAT=                   # json | text (default: json in production)
SLOW_REQUEST_MS=1500          # requests slower than this are logged as warnings

# --- Step 10: deploy ---
# Only if the database connection fails with "self-signed certificate in certificate chain": the certificate text (or its base64) of your database host.
# Last resort instead: DATABASE_SSL=no-verify (still encrypted, but does not check who it is talking to).
DATABASE_CA=
# Used only by `npm run preflight` to check connection maths (how many app instances you run)
INSTANCES=2
