# Copy this file to ".env" and fill in what you need.
# DATABASE_URL is required. For local development run `npm run db:up` and use the value below. See docs/DATABASE.md.

# PostgreSQL connection string. On Supabase use the Transaction pooler string (port 6543).
DATABASE_URL=postgres://shop:shop@localhost:5432/shop
# Supabase only: the Session pooler string (port 5432), used for schema updates and the one-time import.
MIGRATE_DATABASE_URL=
# require | verify-full | disable. Leave empty: hosted databases are encrypted automatically, localhost is not.
PGSSL=
# Connections each app instance may open (instances x this must stay under your database plan limit)
PG_POOL_MAX=10

PORT=3000
# The public address of your shop (used in emails and Paystack return links). No trailing slash.
BASE_URL=http://localhost:3000

# Paystack secret key (starts with sk_test_ or sk_live_). Leave empty to run online payment in demo mode.
PAYSTACK_SECRET_KEY=

# Email through Resend (https://resend.com). Leave empty and emails are only stored in Admin > Marketing.
RESEND_API_KEY=
MAIL_FROM=Shop-Beta <orders@yourdomain.com>

# Optional: create the admin account at first start instead of through the /admin page.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Where uploaded photos live (moves to object storage in step 3). Back this folder up. Default: ./data
DATA_DIR=

# 0 = start with an empty catalogue (no demo products)
SEED_DEMO=1

# Hours ahead of UTC for "today" on the dashboard (Nigeria = 1)
TZ_OFFSET_HOURS=1
# Set to 0 only if the server is exposed directly to the internet with no proxy in front
TRUST_PROXY=1
