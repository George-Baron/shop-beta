# Copy this file to ".env" and fill in what you need.
# DATABASE_URL is required. For local development run `npm run db:up` and use the value below. See docs/DATABASE.md.

# PostgreSQL connection string. On Supabase use the Transaction pooler string (port 6543).
DATABASE_URL=postgres://shop:shop@localhost:5432/shop
# Supabase only: the Session pooler string (port 5432), used for schema updates and the one-time import.
MIGRATE_DATABASE_URL=
# require | verify-full | disable. Leave empty: hosted databases are encrypted automatically, localhost is not.
PGSSL=
# Connections each app instance may open (instances x this must stay under your database plan limit)
PG_POOL_MAX=10

PORT=3000
# The public address of your shop (used in emails and Paystack return links). No trailing slash.
BASE_URL=http://localhost:3000

# Paystack secret key (starts with sk_test_ or sk_live_). Leave empty to run online payment in demo mode.
PAYSTACK_SECRET_KEY=

# Email through Resend (https://resend.com). Leave empty and emails are only stored in Admin > Marketing.
RESEND_API_KEY=
MAIL_FROM=Shop-Beta <orders@yourdomain.com>

# Optional: create the admin account at first start instead of through the /admin page.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Product photos live in Supabase Storage (so every instance shows the same photos). See docs/STORAGE.md.
# Project URL and the service_role key: Supabase dashboard > Project Settings > API. Keep the key SECRET; it is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=shop-images
# Optional: serve photos from your own domain or a CDN in front of the bucket (no trailing slash).
PUBLIC_IMAGE_BASE_URL=
# Leave empty. "local" (photos on this computer's disk) is allowed for development only and is refused in production.
STORAGE_DRIVER=

# Shown in the X-Instance header and /health, to tell instances apart. Render sets this for you.
INSTANCE_ID=
# Milliseconds to keep answering after a shutdown signal while the load balancer moves traffic away. Default 3000.
DRAIN_MS=3000

# Development only: folder for local photos when STORAGE_DRIVER=local. Default: ./data
DATA_DIR=

# 0 = start with an empty catalogue (no demo products)
SEED_DEMO=1

# Hours ahead of UTC for "today" on the dashboard (Nigeria = 1)
TZ_OFFSET_HOURS=1
# Set to 0 only if the server is exposed directly to the internet with no proxy in front
TRUST_PROXY=1

# --- Caching (see docs/CACHING.md). The defaults are right for production; change only if told to. ---
# Seconds that Cloudflare/browsers may keep shared catalogue answers (home, product lists, product pages). 0 = do not share.
EDGE_CACHE_SECONDS=30
# How often each instance checks whether another instance changed the catalogue (milliseconds).
CACHE_POLL_MS=2000
# Most entries kept in memory per instance.
CACHE_MAX_ENTRIES=3000
# Set to 1 to turn the server-side cache off (for debugging only).
CACHE_DISABLED=

# --- Background worker (see docs/JOBS.md). Defaults are right for production. ---
# Email: the worker sends through Resend. For tests only, RESEND_API_URL / PAYSTACK_API_URL point at fake services.
# Set WORKER=0 on a web instance to stop it taking jobs (only if you run scripts/worker.js elsewhere).
WORKER=
WORKER_CONCURRENCY=4
WORKER_POLL_MS=1000
