# Copy this file to ".env" and fill in what you need. Everything is optional for local testing.

PORT=3000
# The public address of your shop (used in emails and Paystack return links). No trailing slash.
BASE_URL=http://localhost:3000

# Paystack secret key (starts with sk_test_ or sk_live_). Leave empty to run online payment in demo mode.
PAYSTACK_SECRET_KEY=

# Email through Resend (https://resend.com). Leave empty and emails are only stored in Admin > Marketing.
RESEND_API_KEY=
MAIL_FROM=Shop-Beta <orders@yourdomain.com>

# Optional: create the admin account at first start instead of through the /admin page.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# PostgreSQL connection string. Supabase: Project Settings > Database > Connection string > Transaction pooler (port 6543), with your password filled in.
# Local development: postgres://postgres@127.0.0.1:5432/shopbeta_dev  (create the empty database first: createdb shopbeta_dev)
DATABASE_URL=postgres://postgres@127.0.0.1:5432/shopbeta_dev
# SSL to the database: on (default for non-local hosts), off (default for localhost), or no-verify (only if your host's certificate cannot be verified)
DATABASE_SSL=
# Connections per app instance. With 2 instances on Supabase keep the total (2 x this number) under the pooler limit.
DB_POOL_MAX=10

# Where uploaded photos live until they move to object storage (step 3). Back this folder up. Default: ./data
DATA_DIR=

# 0 = start with an empty catalogue (no demo products)
SEED_DEMO=1

# Hours ahead of UTC for "today" on the dashboard (Nigeria = 1)
TZ_OFFSET_HOURS=1
# Set to 0 only if the server is exposed directly to the internet with no proxy in front
TRUST_PROXY=1
