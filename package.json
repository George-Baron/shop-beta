{
  "name": "shop-beta",
  "version": "1.0.0",
  "description": "Shop-Beta online store: storefront, checkout, admin dashboard",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --disable-warning=ExperimentalWarning test/smoke.js",
    "migrate": "node lib/migrate.js",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "import:sqlite": "node scripts/sqlite-to-postgres.js",
    "migrate:images": "node scripts/migrate-images.js",
    "check:storage": "node scripts/check-storage.js",
    "lb": "node scripts/dev-lb.js",
    "test:multi": "node --disable-warning=ExperimentalWarning test/two-instances.js",
    "test:images": "node --disable-warning=ExperimentalWarning test/migrate-images.js",
    "test:cache": "node --disable-warning=ExperimentalWarning test/cache.js",
    "test:all": "npm test && npm run test:cache && npm run test:queue && npm run test:multi && npm run test:images",
    "test:queue": "node --disable-warning=ExperimentalWarning test/queue.js",
    "worker": "node --disable-warning=ExperimentalWarning scripts/worker.js"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^4.21.2",
    "pg": "^8.23.1"
  }
}
